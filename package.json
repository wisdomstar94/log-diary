{
  "name": "log-diary-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/apps/*",
    "packages/libs/shared/*",
    "packages/libs/apps/*",
    "packages/libs/apps/turbo-modules/*",
    "packages/webs/*"
  ],
  "scripts": {
    "app:start:local": "npm run start:local -w log-diary",
    "app:start:dev": "npm run start:dev -w log-diary",
    "app:start:prod": "npm run start:prod -w log-diary",
    "app:web:local": "npm run web:local -w log-diary",
    "app:web:dev": "npm run web:dev -w log-diary",
    "app:web:prod": "npm run web:prod -w log-diary",
    "app:android:local": "npm run android:local -w log-diary",
    "app:android:dev": "npm run android:dev -w log-diary",
    "app:android:prod": "npm run android:prod -w log-diary",
    "app:android:local:release": "npm run android:local:release -w log-diary",
    "app:android:dev:release": "npm run android:dev:release -w log-diary",
    "app:android:prod:release": "npm run android:prod:release -w log-diary",
    "app:build:android:local": "npm run build:android:local -w log-diary",
    "app:build:android:dev": "npm run build:android:dev -w log-diary",
    "app:build:android:prod": "npm run build:android:prod -w log-diary",
    "app:ios:local": "npm run ios:local -w log-diary",
    "app:ios:dev": "npm run ios:dev -w log-diary",
    "app:ios:prod": "npm run ios:prod -w log-diary",
    "app:ios:local:release": "npm run ios:local:release -w log-diary",
    "app:ios:dev:release": "npm run ios:dev:release -w log-diary",
    "app:ios:prod:release": "npm run ios:prod:release -w log-diary",
    "app:build:ios:local": "npm run build:ios:local -w log-diary",
    "app:build:ios:dev": "npm run build:ios:dev -w log-diary",
    "app:build:ios:prod": "npm run build:ios:prod -w log-diary",
    "web:github-page:dev": "npm run dev -w github-page",
    "web:github-page:build": "npm run build -w github-page",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "check": "npm run check --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
