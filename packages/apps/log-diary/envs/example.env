# envs/<APP_VARIANT>.env 로 복사해 채운다. (local.env · dev.env · prod.env)
# 셸이나 CI 에서 같은 이름으로 주입한 값이 이 파일보다 우선한다.

# Google OAuth 클라이언트 ID. 환경마다 bundle id 가 달라 클라이언트도 따로 만든다.
# prod 는 필수, local · dev 는 비워 두면 Google 연동만 꺼진 채 실행된다.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# 아래는 릴리즈 서명용. build:* 스크립트에서만 쓴다.
APPLE_TEAM_ID=
# 선택. 비워 두면 Xcode 에 로그인된 계정으로 서명한다.
APP_STORE_CONNECT_API_KEY_PATH=
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=

# 업로드 키스토어. 경로는 절대경로로 적는다.
LOG_DIARY_UPLOAD_STORE_FILE=
LOG_DIARY_UPLOAD_STORE_PASSWORD=
LOG_DIARY_UPLOAD_KEY_ALIAS=
LOG_DIARY_UPLOAD_KEY_PASSWORD=
