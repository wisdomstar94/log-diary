{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/tsconfig-node",
    "types": ["node"]
  },
  "include": ["app.config.ts", "package.json", "config/**/*.ts", "scripts/**/*.ts"]
}
